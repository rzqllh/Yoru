# Backend and Vite are bound to localhost by default.
# Local media providers: copy providers.local.json.example to providers.local.json and fill allowed HTTPS stream URLs.
# Never include secrets in this file or media URLs.

# Optional subtitle API integrations (server process environment variables only).
# Do NOT write real tokens into tracked files or frontend VITE_* variables.
# OPENSUBTITLES_API_KEY=...
# OPENSUBTITLES_ACCESS_TOKEN=...  # login token required for file downloads
# SUBDL_API_KEY=...
# SUBSOURCE_API_KEY=...

# Optional separate Miruro-compatible API operated by you (educational/approved use only).
# Public Miruro demo warns streaming may be blocked; never assume it is production hosting.
# MIRURO_API_BASE=https://your-approved-miruro-api.example

# Optional HMAC signing key for stable subtitle download grants across API restarts/instances.
# YORU_SUBTITLE_SIGNING_SECRET=<random long secret set in backend environment>

# Optional browser-accessible Supabase project for MANUAL cross-device sync.
# Publishable key only; NEVER place service_role, secret or management keys in VITE_*.
# Set these as FRONTEND build-time variables (e.g. frontend/.env.local):
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
# Apply supabase/migrations/20261031_yoru_device_sync.sql and verify per-user RLS.
# Configure email OTP template with {{ .Token }} and an authorized SMTP provider.
